// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String     @id @default(cuid())
  name          String
  category      String     @default("PIECES") // PIECES, ACCESSOIRES, EQUIPEMENTS
  sku           String?    // reference / code
  purchasePrice Float      @default(0) // prix d'achat
  salePrice     Float      @default(0) // prix de vente
  quantity      Int        @default(0) // stock actuel
  minQuantity   Int        @default(0) // stock d'alerte
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sales         Sale[]
  purchases     Purchase[]
}

model Sale {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float    // prix de vente au moment de la vente
  unitCost    Float    // prix d'achat au moment de la vente
  total       Float    // quantity * unitPrice (chiffre d'affaires)
  profit      Float    // (unitPrice - unitCost) * quantity (bénéfice net)
  note        String?
  createdAt   DateTime @default(now())
}

model Purchase {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float    // prix d'achat
  total       Float    // quantity * unitPrice
  note        String?
  createdAt   DateTime @default(now())
}

model Settings {
  id          String   @id @default("1")
  storeName   String   @default("Moto World 29")
  currency    String   @default("DH")
  taxRate     Float    @default(0)
  logoUrl     String?
}
